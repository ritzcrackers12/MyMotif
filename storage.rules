rules_version = '2';
// Display uses getBlob (authenticated SDK), not anonymous <img src="downloadURL">.
service firebase.storage {
  match /b/{bucket}/o {
    // Board images: only the signed-in owner can read/write their prefix.
    match /boards/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
