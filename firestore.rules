rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    /**
     * slimemytaste workspace: canvas HTML, profile fields, timestamps.
     * Path: users/{uid}/boards/{boardId}  (app uses boardId "default")
     */
    match /users/{userId}/boards/{boardId} {
      allow read, write: if isOwner(userId);

      /**
       * Per-frame journal text synced from the canvas.
       * Path: users/{uid}/boards/{boardId}/frames/{frameId}
       */
      match /frames/{frameId} {
        allow read, write: if isOwner(userId);
      }

      /** Saved vibe hearts (nested under workspace board — same access as frames) */
      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId);
      }
    }

    /**
     * Legacy canvas doc used only to read old data and migrate into users/{uid}/boards/default.
     * Path: boards/{uid} where uid is the signed-in user.
     */
    match /boards/{legacyUserId} {
      allow read: if isOwner(legacyUserId);
      allow write: if isOwner(legacyUserId);
    }

  }
}
