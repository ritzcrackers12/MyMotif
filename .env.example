# Copy to .env for Vite-based builds (values are placeholders — use your own).
# Static GitHub Pages build: Groq key is pasted in-app (localStorage), not env.
VITE_GROQ_API_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
